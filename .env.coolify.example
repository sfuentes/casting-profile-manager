# ═══════════════════════════════════════════════════════════════════
# Coolify Environment Variables — copy these into the Coolify UI
# under: Resource → Environment Variables
# ═══════════════════════════════════════════════════════════════════

# ─── REQUIRED ────────────────────────────────────────────────────────

# Strong random secret for JWT signing.
# Generate with: openssl rand -hex 64
# There is deliberately no default: the deploy fails fast if this is unset,
# rather than falling back to a shared value committed to this repo.
JWT_SECRET=change-me-to-a-long-random-secret

# MongoDB root password. Pick something strong.
MONGO_ROOT_PASSWORD=change-me-strong-db-password

# Encrypts users' casting-platform credentials at rest.
# Generate with: openssl rand -hex 32   (exactly 64 hex characters)
#
# WARNING: this key is not recoverable. If you lose or change it, every stored
# platform credential becomes undecryptable and every user has to reconnect
# their platforms. Back it up somewhere outside the server, and do not rotate it
# without re-encrypting first.
CREDENTIAL_ENCRYPTION_KEY=change-me-64-hex-characters

# Public URL where the BACKEND API is reachable (no trailing slash).
# This is baked into the React bundle at build time by Vite.
# Example: https://api.yourdomain.com/api
VITE_API_URL=https://api.yourdomain.com/api

# Public URL of the FRONTEND (used for CORS on the backend).
# Example: https://app.yourdomain.com
FRONTEND_URL=https://app.yourdomain.com

# ─── ROUTING (Coolify magic variables) ───────────────────────────────

# Declared on the services in docker-compose.coolify.yml. Coolify fills these
# in automatically on deploy; set them explicitly only to use your own domains.
# These are what generate the Traefik routing labels — without them the stack
# deploys but is not reachable from the internet.
# SERVICE_FQDN_FRONTEND_80=app.yourdomain.com
# SERVICE_FQDN_BACKEND_5000=api.yourdomain.com

# ─── OPTIONAL — sensible defaults are already set in the compose file ─

# MongoDB root username (default: admin)
# MONGO_ROOT_USERNAME=admin

# JWT expiry (default: 7d)
# JWT_EXPIRES_IN=7d

# JWT cookie expiry in days (default: 7)
# JWT_COOKIE_EXPIRE=7

# Max upload file size in MB (default: 10)
# MAX_FILE_SIZE=10

# Rate limiting: window in ms (default: 600000 = 10 min)
# RATE_LIMIT_WINDOW_MS=600000

# Rate limiting: max requests per window (default: 100)
# RATE_LIMIT_MAX=100

# Number of reverse-proxy hops in front of the backend (default: 1 in
# production, matching Coolify's Traefik). The backend trusts this many hops
# when reading X-Forwarded-For to determine the client IP for rate limiting.
# Only raise it if you add another proxy in front of Coolify (e.g. Cloudflare
# would make it 2). Setting it too high lets clients spoof their IP and bypass
# the rate limiter, so do not inflate it "just in case".
# TRUST_PROXY_HOPS=1

# ─── PLATFORM API KEYS (add only what you use) ───────────────────────

# FILMMAKERS_CLIENT_ID=
# FILMMAKERS_CLIENT_SECRET=
# CASTING_NETWORK_API_KEY=
# SCHAUSPIELERVIDEOS_API_KEY=
# ETALENTA_API_KEY=
# JOBWORK_CLIENT_ID=
# JOBWORK_CLIENT_SECRET=
# WANTED_CLIENT_ID=
# WANTED_CLIENT_SECRET=

# ─── SMTP (optional — for email notifications) ───────────────────────

# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@yourdomain.com
