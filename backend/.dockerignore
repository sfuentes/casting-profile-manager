# Dependencies
node_modules
npm-debug.log
# package-lock.json is NOT excluded - needed for reproducible builds

# Environment files
.env
.env.local
.env.*.local

# Logs
logs
*.log

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode
.idea
*.swp
*.swo
*~

# Git
.git
.gitignore

# Test files
coverage
.nyc_output
test
tests

# Documentation
*.md
!README.md

# Uploads (will be mounted as volume)
uploads/*

# Connector failure captures (mounted as a volume in production).
# Never bake local captures into an image: they are third-party page HTML and
# may carry session state that redaction did not anticipate.
forensics/*

# Temporary files
tmp
temp
