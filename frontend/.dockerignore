# Dependencies — installed inside the image by `npm ci`.
# Without this, `COPY . .` would overwrite the image's node_modules with the
# host's (possibly wrong-architecture) copy.
node_modules
npm-debug.log
# package-lock.json is NOT excluded - needed for reproducible builds

# Build output — regenerated by `npm run build`
dist

# Environment files
.env
.env.local
.env.*.local

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode
.idea
*.swp
*.swo
*~
*.iml

# Git
.git
.gitignore

# Test files
coverage
.nyc_output

# Documentation
*.md
!README.md
